# Brevo — https://app.brevo.com
# Settings → SMTP & API → API keys → create a key. Copy it once; it is not shown again.
BREVO_API_KEY=

# Contacts → Lists → the "Weekly Lesson" list. The ID is in the URL when the list is open,
# and in the list row itself. Turn double opt-in on for this list so Brevo sends the
# confirmation email before anyone joins it.
BREVO_LIST_ID=
